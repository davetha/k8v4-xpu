# One Arc B70 (TP1) with the K8/V4 KV backend: the full k8v4 image built for 4 KV / 24 Q heads
# (libxe2_kv compiled with -DK8V4_TP1; layout.py reads K8V4_TP1=1), plus the INT8-embedding loader.
FROM vllm/vllm-openai-xpu:v0.30.0@sha256:fc0e112afb64e3a06fe8daff34652435822a629412f38efce8f0f67a46636b8d
COPY k8v4_v030 /opt/k8v4/k8v4_v030
COPY build/libxe2_kv_tp1.so /opt/k8v4/libxe2_kv.so
COPY build/libk8v4_sdpa.so /opt/k8v4/libk8v4_sdpa.so
COPY build/libdnnl.so.3 /opt/k8v4/libdnnl.so.3
COPY k8v4_v030/embed_int8_runtime.py /opt/venv/lib/python3.12/site-packages/swift_embed_int8_runtime.py
COPY tools/patch_embed_int8_v030.py /tmp/patch_embed_int8_v030.py
ENV PYTHONPATH=/opt/k8v4 \
    K8V4_TP1=1 \
    XE2_KV_LIB=/opt/k8v4/libxe2_kv.so \
    K8V4_SDPA_LIB=/opt/k8v4/libk8v4_sdpa.so \
    K8V4_PREFILL=onednn \
    K8V4_PREFILL_GEMM=w4a8 \
    VLLM_CACHE_ROOT=/root/.cache/vllm/w4a8-tp1-kv-v1 \
    XE2_KV_S2_NSG=32
RUN python3 -m py_compile /opt/k8v4/k8v4_v030/backend.py /opt/k8v4/k8v4_v030/dequant.py /opt/k8v4/k8v4_v030/onednn_prefill.py \
      /opt/k8v4/k8v4_v030/w4a8_prefill.py /opt/k8v4/k8v4_v030/layout.py \
 && python3 /opt/k8v4/k8v4_v030/patch_installed_vllm.py \
 && python3 /tmp/patch_embed_int8_v030.py && PYTHONPATH=/workspace/vllm python3 /tmp/patch_embed_int8_v030.py \
 && K8V4_TP1=1 python3 -c "from k8v4_v030.layout import HKV, HQ, BYTES_PER_TOKEN; assert (HKV, HQ) == (4, 24); print(HKV, HQ, BYTES_PER_TOKEN)"
