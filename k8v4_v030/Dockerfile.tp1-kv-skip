# TP1 K8/V4 + DFlash2: the 27B on K8/V4, the drafter layers (kv-cache-dtype-skip-layers) on the stock XPU backend
# in VLLM_KV_SKIP_DTYPE (patch_vllm_skip_fp8.py).
FROM vllm-openai-xpu:v0.30.0-k8v4-tp1-kv
COPY k8v4_v030/patch_vllm_skip_fp8.py /tmp/patch_vllm_skip_fp8.py
ENV VLLM_KV_SKIP_DTYPE=fp8 VLLM_CACHE_ROOT=/root/.cache/vllm/w4a8-tp1-kv-skip-v1
RUN python3 /tmp/patch_vllm_skip_fp8.py /opt/venv/lib/python3.12/site-packages/vllm \
 && python3 -m py_compile /opt/venv/lib/python3.12/site-packages/vllm/model_executor/layers/attention/attention.py /opt/venv/lib/python3.12/site-packages/vllm/platforms/interface.py /opt/venv/lib/python3.12/site-packages/vllm/v1/kv_cache_interface.py
